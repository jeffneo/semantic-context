# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Neo4j (docker-compose.yml) --------------------------------------------------------
# Host ports. If you change NEO4J_BOLT_PORT, change neo4j.uri in the estate's config to match.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=change-me
# Optional overrides (defaults in docker-compose.yml)
# NEO4J_IMAGE=neo4j:2026.07.1-enterprise
# NEO4J_HEAP=4G
# NEO4J_PAGECACHE=2G

# Licenses: not in the repo. Point these at your own files.
# GDS_LICENSE_PATH=./gds.license
# NES_LICENSE_PATH=./nes.license

# --- Neo4j Enterprise Studio (docker compose --profile nes) ------------------------------
NES_PORT=8080
# Password for Studio's asset-store service account (tools_service); nes-init sets it.
NES_TOOLS_PASSWORD=change-me

# --- qlsc -------------------------------------------------------------------------------
# The estate's config file, so `qlsc <command>` needs no --config; and its work directory,
# which the parser service reads the catalog snapshot from.
QLSC_CONFIG=examples/fennmoor-bank/estate.yaml
QLSC_WORK=./examples/fennmoor-bank/work

# --- LLM: Anthropic (naming, SQL) --------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Embeddings: Azure OpenAI (text-embedding-3-large deployment, 512 dimensions) ---------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- SQL parse service (parser/) ---------------------------------------------------------
PARSER_PORT=8090
PARSER_WORKERS=4

# Warehouse access is not configured here. For BigQuery, the estate's config names the project and
# a gcloud configuration (warehouse.gcloud_config), and qlsc runs gcloud under that configuration.
