# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Neo4j (docker-compose.yml) --------------------------------------------------------
# Host ports. If you change NEO4J_BOLT_PORT, change neo4j.uri in pipeline/estate.yaml to match.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=change-me
# Optional overrides (defaults in docker-compose.yml)
# NEO4J_IMAGE=neo4j:2026.07.1-enterprise
# NEO4J_HEAP=4G
# NEO4J_PAGECACHE=2G

# Licenses: not in the repo. Point these at your own files.
# GDS_LICENSE_PATH=./gds.license
# NES_LICENSE_PATH=./nes.license

# --- Neo4j Enterprise Studio (docker compose --profile nes) ------------------------------
NES_PORT=8080
# Password for Studio's asset-store service account (tools_service); nes-init sets it.
NES_TOOLS_PASSWORD=change-me

# --- LLM: Anthropic (naming, question answering) -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Embeddings: Azure OpenAI (text-embedding-3-large deployment, 512 dimensions) ---------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- SQL parse service (pipeline/parser) ------------------------------------------------
PARSER_PORT=8090
PARSER_WORKERS=4

# BigQuery access is not configured here: pipeline/estate.yaml names the project and a gcloud
# configuration (bigquery.gcloud_config), and the pipeline runs gcloud under that config.
