# Secrets and credentials
.env
.env.*
!.env.example
*.license
*.pem
*.key
service-account*.json

# What qlsc writes for an estate: extracts, parse records, reports, and the LLM and embedding caches
# (~90 MB for the example). Regenerable: qlsc extract, then qlsc build.
examples/*/work/

# An example's generated spec build and log, regenerable byte for byte (generate/build.py,
# templates.py, simulate.py). The example's log alone is ~70 MB, over GitHub's 50 MB warning.
# Its scores (results/) are tracked.
examples/*/build/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
